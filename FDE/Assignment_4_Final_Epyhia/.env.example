# Tier 3: Action Gate only. Never expose these values to Tier 1 or Tier 2.
ACTION_GATE_HOST=127.0.0.1
ACTION_GATE_PORT=4100
ACTION_GATE_AUTO_MIGRATE=false
ACTION_GATE_DB_PATH=.data/action-gate.sqlite
DEPLOY_PROVIDER=local
LOCAL_DEPLOY_ROOT=.deployments

# Scoped capability handles. These are provider-key-free handles issued to callers.
# Replace every example value outside local development.
WEB_BUILDER_CAPABILITY_HANDLE=dev-web-builder-handle-change-me
ADMIN_APPROVAL_CAPABILITY_HANDLE=dev-admin-approval-handle-change-me
RUNTIME_CONTROL_CAPABILITY_HANDLE=dev-runtime-control-handle-change-me
STRATEGIST_CAPABILITY_HANDLE=dev-strategist-handle-change-me
OPS_CAPABILITY_HANDLE=dev-ops-handle-change-me
MARKETER_CAPABILITY_HANDLE=dev-marketer-handle-change-me
# Shared only by Tier 1 and Tier 2; use a distinct 32+ character alphanumeric value.
TIER1_RUNTIME_CAPABILITY_HANDLE=

# Required only when DEPLOY_PROVIDER=cloudflare. Keep in Tier 3.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Future gated providers. Keep in Tier 3.
OPENAI_API_KEY=
DATABASE_URL=
STRIPE_SANDBOX_PUBLISHABLE_KEY=
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth0 Management API M2M client. Grant only delete:users.
AUTH0_MANAGEMENT_ISSUER_BASE_URL=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# Tier 3 R2 provider credentials.
CLOUDFLARE_R2_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_S3_URL=
R2_BUCKET=

# Tier 3 paid Veo provider. Leave both absent until the exact video payload is ready.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Deployment-safe alternative to the local file path. Configure only one source.
GOOGLE_CLOUD_CREDENTIALS_JSON=
GOOGLE_CLOUD_LOCATION=us-central1

# Tier 2 private runtime.
ACTION_GATE_URL=http://127.0.0.1:4100
PUBLIC_API_BASE_URL=http://localhost:3000
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=4200

# Tier 1 public web app. SECRET is the Auth0 session-cookie encryption key.
RUNTIME_URL=http://127.0.0.1:4200
ISSUER_BASE_URL=
CLIENT_ID=
SECRET=
BASE_URL=http://localhost:3000
PORT=3000

# Deployment tooling only; never expose these to Tier 1 or Tier 2 app processes.
FLY_ORG_TOKEN=
FLY_ORG=
FLY_APP_PREFIX=
