# Tier 3 only: provider credentials and capability registry.
ACTION_GATE_HOST=127.0.0.1
ACTION_GATE_PORT=4100
ACTION_GATE_DB_PATH=.data/action-gate.sqlite
DEPLOY_PROVIDER=local
LOCAL_DEPLOY_ROOT=.deployments
WEB_BUILDER_CAPABILITY_HANDLE=replace-with-random-handle
ADMIN_APPROVAL_CAPABILITY_HANDLE=replace-with-random-handle
RUNTIME_CONTROL_CAPABILITY_HANDLE=replace-with-random-handle
STRATEGIST_CAPABILITY_HANDLE=replace-with-random-handle
OPS_CAPABILITY_HANDLE=replace-with-random-handle
MARKETER_CAPABILITY_HANDLE=replace-with-random-handle

# LIVE Cloudflare provider
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Later Tier 3 providers
OPENAI_API_KEY=
DATABASE_URL=
STRIPE_SANDBOX_PUBLISHABLE_KEY=
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# R2 artifact storage
CLOUDFLARE_R2_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_S3_URL=
R2_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_CREDENTIALS_JSON=
GOOGLE_CLOUD_LOCATION=us-central1
