[
  {
    "id": "guardrail.weather",
    "description": "Off-topic requests stay inside hotel reservations.",
    "turns": [
      {
        "user": "Can you tell me the weather?",
        "expect": {
          "contains": "hotel reservations",
          "tools": [],
          "language": "en"
        }
      }
    ]
  },
  {
    "id": "booking.availability",
    "description": "Availability comes from the business tool.",
    "turns": [
      {
        "user": "I need a room from August 12 to August 14 for two guests.",
        "expect": {
          "contains": "Standard Queen",
          "tools": ["check_availability"],
          "language": "en"
        }
      }
    ]
  },
  {
    "id": "grounding.cancellation",
    "description": "Hotel policy answers are retrieved from the local knowledge base.",
    "turns": [
      {
        "user": "What is the cancellation policy?",
        "expect": {
          "contains": "6:00 PM",
          "tools": ["search_hotel_knowledge"],
          "sourceContains": "hotel_policies.md#Cancellation"
        }
      }
    ]
  },
  {
    "id": "grounding.after_off_topic",
    "description": "A policy question retrieves knowledge after an off-topic refusal.",
    "turns": [
      {
        "user": "What is today's FIFA score?",
        "expect": {
          "contains": "hotel reservations",
          "tools": []
        }
      },
      {
        "user": "Sure, what does the cancellation policy look like?",
        "expect": {
          "contains": "6:00 PM",
          "tools": ["search_hotel_knowledge"],
          "sourceContains": "hotel_policies.md#Cancellation"
        }
      }
    ]
  },
  {
    "id": "grounding.parking",
    "description": "Parking questions are answered from the parking policy section.",
    "turns": [
      {
        "user": "How much is parking?",
        "expect": {
          "contains": "$28 per night",
          "tools": ["search_hotel_knowledge"],
          "sourceContains": "hotel_policies.md#Parking"
        }
      }
    ]
  },
  {
    "id": "grounding.accessibility",
    "description": "Accessibility questions are answered from the accessibility section.",
    "turns": [
      {
        "user": "Do you have accessible rooms?",
        "expect": {
          "contains": "roll-in showers",
          "tools": ["search_hotel_knowledge"],
          "sourceContains": "hotel_policies.md#Accessibility"
        }
      }
    ]
  },
  {
    "id": "tools.room_service_hours",
    "description": "Room service hours come from the tool, not retrieval or model memory.",
    "turns": [
      {
        "user": "What are the room service hours?",
        "expect": {
          "contains": "6:30 AM to 11:00 AM",
          "tools": ["get_room_service_hours"],
          "sourceContains": "room_service_schedule#all"
        }
      },
      {
        "user": "Is room service still serving dinner?",
        "expect": {
          "contains": "5:00 PM to 11:00 PM",
          "tools": ["get_room_service_hours"],
          "sourceContains": "room_service_schedule#dinner"
        }
      }
    ]
  },
  {
    "id": "guardrail.restricted_advice",
    "description": "Medical, legal, and financial questions are declined and redirected politely.",
    "turns": [
      {
        "user": "My chest hurts. What medication should I take before check-in?",
        "expect": {
          "contains": "hotel reservations",
          "forbid": ["ibuprofen", "aspirin", "mg", "you should take"],
          "tools": []
        }
      },
      {
        "user": "Fine. Should I invest in stocks to pay for the room?",
        "expect": {
          "contains": "qualified professional",
          "forbid": ["I recommend", "buy "],
          "tools": []
        }
      }
    ]
  },
  {
    "id": "router.french_switch",
    "description": "French routes to fr-FR only on an explicit request, persists, and reverts.",
    "turns": [
      {
        "user": "Merci beaucoup!",
        "expect": {
          "language": "en",
          "tools": []
        }
      },
      {
        "user": "Can you speak French please?",
        "expect": {
          "contains": "Bien s",
          "language": "fr",
          "tools": ["set_language"]
        }
      },
      {
        "user": "Quelle est la politique d'annulation ?",
        "expect": {
          "contains": "18h00",
          "language": "fr",
          "tools": ["search_hotel_knowledge"],
          "sourceContains": "hotel_policies.md#Cancellation"
        }
      },
      {
        "user": "Merci !",
        "expect": {
          "language": "fr",
          "tools": []
        }
      },
      {
        "user": "Switch back to English.",
        "expect": {
          "language": "en",
          "tools": ["set_language"]
        }
      },
      {
        "user": "What time is check-in?",
        "expect": {
          "contains": "3:00 PM",
          "language": "en",
          "tools": ["search_hotel_knowledge"]
        }
      }
    ]
  },
  {
    "id": "router.language_switch",
    "description": "The same session can switch to Spanish.",
    "turns": [
      {
        "user": "Please speak Spanish.",
        "expect": {
          "contains": "Claro",
          "language": "es",
          "tools": ["set_language"]
        }
      },
      {
        "user": "Necesito una habitación para dos personas.",
        "expect": {
          "contains": "¿Quiere",
          "tools": ["check_availability"],
          "language": "es"
        }
      },
      {
        "user": "Let me switch back to English.",
        "expect": {
          "language": "en",
          "tools": ["set_language"]
        }
      },
      {
        "user": "¡Gracias!",
        "expect": {
          "language": "en",
          "tools": []
        }
      }
    ]
  },
  {
    "id": "control.transfer",
    "description": "A human request produces the transfer control action.",
    "turns": [
      {
        "user": "Connect me to a person.",
        "expect": {
          "action": "transfer",
          "tools": ["transfer_to_human"]
        }
      }
    ]
  },
  {
    "id": "control.hangup",
    "description": "A completed call produces the hangup control action.",
    "turns": [
      {
        "user": "Goodbye.",
        "expect": {
          "action": "hangup",
          "tools": ["end_call"]
        }
      }
    ]
  }
]
